---
import ExpandableImage from "@/components/ExpandableImage";
import ImageSlider from "@/components/ImageSlider";
import MapPinIcon from "@/components/MapPinIcon";
import PageConstellation from "@/components/PageConstellation";
import Sparkle from "@/components/Sparkle";

const matrixColumns = [
  { i: 6, chars: ["7", "3", "z", "9"] },
  { i: 9, chars: ["A", "1", "f"] },
  { i: 5, chars: ["0", "q", "8", "k", "2"] },
  { i: 11, chars: ["$", "5", "m", "0", "1"] },
  { i: 7, chars: ["j", "4", "7"] },
  { i: 13, chars: ["9", "s", "0", "b", "3", "x"] },
  { i: 8, chars: ["2", "y", "6"] },
  { i: 6, chars: ["#", "1", "d", "9"] },
  { i: 10, chars: ["4", "8", "p", "0", "n"] },
  { i: 5, chars: ["u", "3", "g"] },
  { i: 12, chars: ["a", "t", "7", "2", "g", "h", "0", "k"] },
  { i: 9, chars: ["6", "3", "0"] },
  { i: 6, chars: ["7", "s", "b", "q"] },
  { i: 14, chars: ["1", "e", "5", "z", "8", "0"] },
  { i: 7, chars: ["%", "4", "w"] },
  { i: 11, chars: ["3", "0", "r", "9", "1"] },
  { i: 5, chars: ["k", "6", "2"] },
  { i: 8, chars: ["9", "0", "v", "3"] },
  { i: 10, chars: ["c", "5", "1", "8"] },
  { i: 6, chars: ["0", "&", "7", "2"] },
  { i: 13, chars: ["5", "m", "9", "0", "d", "1"] },
  { i: 8, chars: ["2", "f", "0", "6"] },
];

const compactInset =
  "absolute object-contain top-4 left-8 h-[calc(100%-2rem)] w-[calc(100%-4rem)] sm:top-6 sm:left-10 sm:h-[calc(100%-3rem)] sm:w-[calc(100%-5rem)]";

const brandingItems = [
  { src: "/about-images/branding/1-skitzophrenic.jpg", alt: "Skitzophrenic single artwork" },
  {
    src: "/about-images/branding/2-msm-mind-control.png",
    alt: "MSM Mind Control single artwork",
    blackBg: true,
    inset: true,
  },
  { src: "/about-images/branding/3-Epstein%20island.jpeg", alt: "Epstein Island single artwork" },
  {
    src: "/about-images/branding/4-sovereign-alliance-seal.svg",
    alt: "Sovereign Alliance seal logo",
    blackBg: true,
    inset: true,
  },
  { src: "/about-images/branding/5-yin-yang.jpg", alt: "Yin Yang single artwork" },
  {
    src: "/about-images/branding/6-cat-spirit-animal.png",
    alt: "Spirit Animal single artwork",
    blackBg: true,
    inset: true,
    insetClassName: compactInset,
  },
  { src: "/about-images/branding/7-confess.jpg", alt: "Confess single artwork" },
  { src: "/about-images/branding/8-earth-unhacked.jpg", alt: "Earth Unhacked single artwork" },
  {
    src: "/about-images/branding/9-mercy-for-your-soul.jpg",
    alt: "Mercy for Your Soul single artwork",
  },
  {
    src: "/about-images/branding/10-follow-white-rabbit.png",
    alt: "Follow the White Rabbit single artwork",
    blackBg: true,
    inset: true,
  },
  { src: "/about-images/branding/11-you-mad-as-f.jpg", alt: "You Mad As F single artwork" },
  {
    src: "/about-images/branding/12-psywar-frequency.jpg",
    alt: "Psywar Frequency single artwork",
    blackBg: true,
    inset: true,
    insetClassName: compactInset,
  },
  { src: "/about-images/branding/13-sunshine-cover.jpg", alt: "Sunshine single artwork" },
  {
    src: "/about-images/branding/14-door-close-door-opens.png",
    alt: "Door Closes, Door Opens single artwork",
    blackBg: true,
    inset: true,
    insetClassName: compactInset,
  },
  {
    src: "/about-images/branding/15-way-beyond-the-stars.jpg",
    alt: "Way Beyond the Stars single artwork",
  },
  {
    src: "/about-images/branding/16-monk-impweye.PNG",
    alt: "The Revolution Will Not Be Televised single artwork",
    blackBg: true,
    inset: true,
    insetClassName: compactInset,
  },
  {
    src: "/about-images/branding/17-photographic-memories.jpg",
    alt: "Photographic Memories single artwork",
  },
];
---

<PageConstellation client:load />

<section class="mx-auto max-w-4xl px-6 pb-24 pt-36">
  <article class="editorial-card relative rounded-[2rem] bg-[var(--color-indigo-deep)] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.75)]">
    <div class="p-8 sm:p-10 md:p-12">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <div class="matrix-frame matrix-frame--profile w-28 shrink-0 sm:w-32">
          <div class="matrix-frame-bg" aria-hidden="true">
            {matrixColumns.map((column) => (
              <span style={`--i: ${column.i}`} class="matrix-code-line">
                {column.chars.map((character) => <span class="matrix-code">{character}</span>)}
              </span>
            ))}
          </div>
          <div class="matrix-frame-photo-wrap">
            <ExpandableImage
              src="/jason-lee.jpg"
              alt="Jason Lee"
              className="h-full w-full object-cover"
              priority
              client:load
            />
          </div>
        </div>

        <div class="min-w-0">
          <div class="flex items-center gap-3 text-xs uppercase tracking-[0.3em] text-gold">
            <Sparkle className="h-3 w-3 shrink-0" />
            About
            <span class="h-px flex-1 bg-cream/15"></span>
          </div>

          <h1 class="mt-4 font-serif text-4xl leading-tight text-cream sm:text-5xl">
            Jason Lee <span class="text-cream/65">|</span> Galactic Monk
          </h1>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-cream/10 py-3 text-xs font-medium uppercase tracking-[0.2em]">
        <span class="text-sage">Producer &amp; Alchemist</span>
        <span class="hidden h-3 w-px bg-cream/20 sm:block"></span>
        <span class="inline-flex items-center gap-2 text-coral">
          <span class="relative flex h-4 w-4 items-center justify-center">
            <span class="absolute inline-flex h-3 w-3 animate-ping rounded-full bg-coral/30"></span>
            <MapPinIcon className="relative h-3.5 w-3.5 text-cream" />
          </span>
          Los Angeles · On-Location &amp; Remote
        </span>
      </div>

      <div class="mt-8 text-base leading-relaxed text-cream-dim">
        <p class="about-dropcap font-serif text-xl leading-relaxed text-cream">
          Jason Lee is a Los Angeles-based producer and multidimensional alchemist inspired and
          motivated by the discipline of self-mastery.
        </p>

        <div class="my-10 grid grid-cols-2 gap-4 sm:gap-6">
          <figure>
            <ExpandableImage
              src="/about-images/monk-boxing-2.jpg"
              alt="Jason Lee shadowboxing, self-portrait"
              className="aspect-square w-full rounded-2xl object-cover shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6)]"
              client:visible
            />
            <figcaption class="mt-3 text-center">
              <span class="block font-serif text-sm italic text-cream/70">Shadowboxing</span>
              <span class="mt-1 block text-[10px] uppercase tracking-[0.25em] text-cream/60">Self-portrait</span>
            </figcaption>
          </figure>
          <figure>
            <ExpandableImage
              src="/about-images/monk-boxing.jpg"
              alt="Jason Lee lightboxing, self-portrait"
              className="aspect-square w-full rounded-2xl object-cover shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6)]"
              client:visible
            />
            <figcaption class="mt-3 text-center">
              <span class="block font-serif text-sm italic text-cream/70">Lightboxing</span>
              <span class="mt-1 block text-[10px] uppercase tracking-[0.25em] text-cream/60">Self-portrait</span>
            </figcaption>
          </figure>
        </div>

        <p>
          Every creative body begins with raw muse: an idea, an image, a sound, a feeling. The alchemy is in
          transforming those separate parts into a complete and entire experience far more powerful than they are when isolated. As a producer, Galactic Monk perceives the
          creative process as a practice of transmutation, crafting footage, photography, sound, and story into
          masterpieces with energy, intention, and vibe.
        </p>

        <figure class="my-10 mx-auto w-full max-w-2xl">
          <figcaption class="mb-4 text-center text-[11px] uppercase tracking-[0.25em] text-cream/60">
            Art Direction &amp; Ideation
          </figcaption>
          <ImageSlider items={brandingItems} client:visible />
        </figure>

        <p>
          Galactic Monk is also undoubtedly a creator himself. His own work is the lab where equipment is tested,
          techniques are developed, and seemingly disconnected crafts intertwine to craft unique vibes. Being a
          starving artist taught Monk how to achieve stellar visual and audio quality while navigating the technical
          challenges of manifesting ideation into the 3D physical reality. He perceives other artists and their
          visions from that same perspective: not simply as a technician hired to execute, but as a fellow creator
          who innerstands the journey from imagination to manifestation.
        </p>

        <blockquote class="my-8 border-l-2 border-gold/70 pl-5 font-serif text-xl italic leading-snug text-cream">
          &ldquo;A master alchemist can even transmute the night sky as mana.&rdquo;
          <footer class="mt-2 font-sans text-xs not-italic uppercase tracking-[0.2em] text-cream/60">
            — Jason Lee
          </footer>
        </blockquote>

        <p>
          Multi-faceted and knowledgeable as a digital media producer, Galactic Monk specializes in four interdimensionally connected crafts: film
          &amp; video production, photography, audio recording, mixing &amp; mastering, and web design &amp;
          development. From concept and production through editing and final delivery, each piece is approached
          with curiosity, precision, and an obsessive attention to the fine technical detail of the end output.
        </p>

        <figure class="my-10">
          <ExpandableImage
            src="/about-images/jason-newsboy-cap.jpg"
            alt="Jason Lee in a newsboy cap, self-portrait"
            className="aspect-[3/2] w-full rounded-2xl object-cover shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6)]"
            client:visible
          />
          <figcaption class="mt-3 text-center">
            <span class="block font-serif text-sm italic text-cream/70">Old Head</span>
            <span class="mt-1 block text-[10px] uppercase tracking-[0.25em] text-cream/60">Self-Portrait</span>
          </figcaption>
        </figure>

        <p class="mt-6">
          Galactic Monk&apos;s alchemy is intuitive; led by a lifelong journey of overcoming adversity and solving
          problems. Without all the ups, downs, and setbacks in the past, he would never have achieved the knowledge, wisdom,
          and experience he possesses presently. New techniques are explored. New tools are mastered. New perspectives are experimented with. His
          dream is never just to create content, but to continually refine his craft and manifest magical art worthy of
          being cast into our mystically evolving &amp; breathing Multiverse. For Galactic Monk, creative mastery and
          self-mastery are the same pursuit, each nourishing the other. The New Earth has already arrived. We are
          weaving it into existence, one piece at a time.
        </p>
      </div>
    </div>
  </article>

  <div class="mt-8 flex flex-col items-center">
    <div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gold">
      <Sparkle className="h-3 w-3" />
      LET&apos;S CO-CREATE
    </div>
    <a href="/contact/" class="btn-nova btn-nova-urgent mt-4 text-sm font-medium tracking-wide">
      <span class="btn-nova-inner">
        <strong class="btn-nova-label">Reach Out</strong>
        <span class="btn-nova-stars" aria-hidden="true">
          <span class="btn-nova-stars-field"></span>
        </span>
        <span class="btn-nova-glow" aria-hidden="true">
          <span class="btn-nova-circle"></span>
          <span class="btn-nova-circle"></span>
        </span>
      </span>
    </a>
  </div>
</section>
