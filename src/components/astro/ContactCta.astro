---
import SectionHeading from "@/components/SectionHeading";
---
<section class="swirl-bg px-6 py-28 text-center shadow-[0_-24px_60px_-32px_rgba(0,0,0,0.5)]">
  <SectionHeading
    align="center"
    eyebrow="LET'S CO-CREATE"
    title="Have an idea orbiting your consciousness?"
    description="Whether it’s a film, photoshoot, record, or digital world, let’s co-create a vibe people can feel."
  />
  <a href="/contact/" class="btn-nova btn-nova-urgent mt-8 text-sm font-medium tracking-wide">
    <span class="btn-nova-inner"><strong class="btn-nova-label">Reach Out</strong><span class="btn-nova-stars" aria-hidden="true"><span class="btn-nova-stars-field"></span></span><span class="btn-nova-glow" aria-hidden="true"><span class="btn-nova-circle"></span><span class="btn-nova-circle"></span></span></span>
  </a>
</section>
